---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Playground from '../components/Playground.tsx';
---

<StarlightPage
  frontmatter={{
    title: 'Playground',
    description: 'Run a real resilience pipeline in your browser against a simulated flaky dependency, and copy the TypeScript for it.',
    template: 'splash',
    tableOfContents: false,
    pagefind: true,
  }}
>
  <p>
    This page runs the actual <code>@ylcnfrht/resilience</code> library in your browser. Tune the flaky dependency on the left, switch strategies
    on and off, press <strong>Start</strong> and watch each request in the timeline. Statistics come from <code>createStats</code>
    over a 10-second rolling window. Timing is real; the same seed replays the same sequence of failures and latencies.
  </p>
  <Playground client:load />
</StarlightPage>
