      },
      "require": {
        "types": "./dist/cjs/axios.d.ts",
        "default": "./dist/cjs/axios.js"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/esm/otel.d.ts",
        "default": "./dist/esm/otel.js"
      },
      "require": {
        "types": "./dist/cjs/otel.d.ts",
        "default": "./dist/cjs/otel.js"
      }
    },
    "./prometheus": {
      "import": {
        "types": "./dist/esm/prometheus.d.ts",
        "default": "./dist/esm/prometheus.js"
      },
      "require": {
        "types": "./dist/cjs/prometheus.d.ts",
        "default": "./dist/cjs/prometheus.js"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/esm/http.d.ts",
