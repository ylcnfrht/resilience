---
/** Generative SVG art for the landing bento cards. Each one depicts what the strategy actually does. */
interface Props {
  kind: 'failures' | 'overload' | 'latency' | 'typed' | 'distributed' | 'testing';
}
const { kind } = Astro.props;

let seed = kind.length * 97 + 13;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

// failures: exponential backoff as stacked pixel columns; failed attempts dim, the final one succeeds.
const backoff = [1, 2, 4, 8, 12].map((h, i) => ({ x: 70 + i * 74, h, ok: i === 4 }));

// overload: a bulkhead grid (busy / queued / rejected cells) under an adaptive-limit curve.
const cells = Array.from({ length: 12 * 5 }, (_, i) => {
  const col = i % 12;
  const row = Math.floor(i / 12);
  const limit = 2 + Math.round(2.4 * Math.sin((col / 11) * Math.PI) + col * 0.12);
  const state = row < limit ? 'busy' : row < limit + 1 ? 'queued' : rand() < 0.18 ? 'rejected' : 'idle';
  return { x: 46 + col * 34, y: 182 - row * 30, state };
});
const curve = Array.from({ length: 12 }, (_, c) => {
  const limit = 2 + 2.4 * Math.sin((c / 11) * Math.PI) + c * 0.12;
  return `${c === 0 ? 'M' : 'L'} ${46 + c * 34 + 12} ${196 - limit * 30}`;
}).join(' ');

// typed errors: one call fanning out into typed outcomes.
const branches = [
  { label: 'ok', y: 40, tone: 'accent' },
  { label: 'TIMEOUT', y: 88, tone: 'amber' },
  { label: 'CIRCUIT_OPEN', y: 136, tone: 'red' },
  { label: 'NOT_FOUND', y: 184, tone: 'lavender' },
];
---

<svg class:list={['rp-illo', kind]} viewBox="0 0 480 220" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  {kind === 'failures' && (
    <g>
      <line x1="40" y1="196" x2="440" y2="196" class="axis"></line>
      {backoff.map((b) => (
        <g>
          {Array.from({ length: b.h }, (_, k) => (
            <rect x={b.x} y={186 - k * 14} width="44" height="11" rx="2.5" class:list={['px', b.ok ? 'ok' : 'fail']} style={`animation-delay:${(b.x / 74) * 0.18 + k * 0.03}s`}></rect>
          ))}
          <text x={b.x + 22} y="214" class="tick">{b.ok ? '✓' : `+${b.h * 100}ms`}</text>
        </g>
      ))}
    </g>
  )}

  {kind === 'overload' && (
    <g>
      {cells.map((c) => <rect x={c.x} y={c.y} width="24" height="22" rx="4" class:list={['cell', c.state]}></rect>)}
      <path d={curve} class="limit"></path>
      <text x="430" y="30" class="tag">adaptive limit</text>
    </g>
  )}

  {kind === 'latency' && (
    <g>
      {[0, 1, 2].map((i) => (
        <g transform={`translate(0 ${48 + i * 62})`}>
          <text x="30" y="5" class="tick start">{i === 0 ? 'primary' : `hedge ${i}`}</text>
          <line x1="110" y1="0" x2="440" y2="0" class="track"></line>
          <rect x={110 + i * 60} y="-9" height="18" rx="9" class:list={['run', i === 1 ? 'win' : 'lose']} width={i === 0 ? 300 : i === 1 ? 150 : 120}>
          </rect>
          {i === 1 && <circle cx={110 + 60 + 150} cy="0" r="12" class="win-dot"></circle>}
          {i === 1 && <path d={`M ${110 + 60 + 144} 0 l 4 4 l 8 -8`} class="check"></path>}
        </g>
      ))}
      <line x1="320" y1="20" x2="320" y2="200" class="deadline"></line>
      <text x="326" y="214" class="tick">first wins, rest aborted</text>
    </g>
  )}

  {kind === 'typed' && (
    <g>
      <rect x="28" y="96" width="96" height="30" rx="8" class="src"></rect>
      <text x="76" y="116" class="code">settle()</text>
      {branches.map((b) => (
        <g>
          <path d={`M 124 111 C 200 111, 210 ${b.y}, 270 ${b.y}`} class:list={['branch', b.tone]}></path>
          <rect x="270" y={b.y - 15} width={b.label.length * 9 + 26} height="30" rx="8" class:list={['chip', b.tone]}></rect>
          <text x={283} y={b.y + 5} class:list={['code', 'left', b.tone]}>{b.label}</text>
        </g>
      ))}
    </g>
  )}

  {kind === 'distributed' && (
    <g>
      {[
        { x: 40, y: 30 },
        { x: 40, y: 150 },
        { x: 360, y: 30 },
        { x: 360, y: 150 },
      ].map((n, i) => (
        <g>
          <path d={`M ${n.x + 40} ${n.y + 20} L ${n.x < 200 ? 190 : 290} ${110}`} class="link" style={`animation-delay:${i * 0.4}s`}></path>
          <rect x={n.x} y={n.y} width="80" height="40" rx="10" class="inst"></rect>
          <circle cx={n.x + 16} cy={n.y + 20} r="4" class:list={['led', i === 2 ? 'open' : 'closed']}></circle>
          <text x={n.x + 48} y={n.y + 24} class="tick">{`api-${i + 1}`}</text>
        </g>
      ))}
      <rect x="170" y="84" width="140" height="52" rx="12" class="store"></rect>
      <text x="240" y="108" class="code">redis</text>
      <text x="240" y="124" class="tick">state · limits · locks</text>
    </g>
  )}

  {kind === 'testing' && (
    <g>
      <line x1="40" y1="110" x2="440" y2="110" class="track"></line>
      {Array.from({ length: 21 }, (_, i) => (
        <line x1={40 + i * 20} y1={i % 5 === 0 ? 96 : 102} x2={40 + i * 20} y2="110" class="tickline"></line>
      ))}
      {[{ x: 60, l: '1s' }, { x: 160, l: '10s' }, { x: 260, l: '10s' }, { x: 360, l: '10s' }].map((m) => (
        <g>
          <circle cx={m.x} cy="110" r="5" class="mark"></circle>
          <text x={m.x} y="138" class="tick">{m.l}</text>
        </g>
      ))}
      <rect x="40" y="58" width="400" height="6" rx="3" class="ff"></rect>
      <text x="40" y="44" class="tag left">34s of retries and timeouts</text>
      <text x="440" y="176" class="code big">runAll() → 0.02s</text>
    </g>
  )}
</svg>

<style>
  .rp-illo {
    width: 100%;
    height: auto;
    display: block;
    color: var(--rp-text-faint);
    font-family: var(--rp-mono);
  }
  .axis,
  .track {
    stroke: var(--rp-hairline-strong);
    stroke-width: 1;
  }
  .tick {
    fill: var(--rp-text-faint);
    font-size: 10px;
    text-anchor: middle;
  }
  .tick.start {
    text-anchor: start;
  }
  .tag {
    fill: var(--rp-accent);
    font-size: 10px;
    text-anchor: end;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tag.left {
    text-anchor: start;
    fill: var(--rp-text-faint);
  }
  .code {
    fill: var(--rp-text);
    font-size: 11px;
    text-anchor: middle;
  }
  .code.left {
    text-anchor: start;
  }
  .code.big {
    text-anchor: end;
    font-size: 15px;
    fill: var(--rp-accent);
  }
  .px {
    opacity: 0;
    animation: rp-rise 0.5s ease-out forwards;
  }
  .px.fail {
    fill: color-mix(in oklab, var(--rp-red) 28%, var(--rp-surface-3));
  }
  .px.ok {
    fill: var(--rp-accent);
  }
  .cell {
    fill: var(--rp-surface-3);
  }
  .cell.busy {
    fill: color-mix(in oklab, var(--rp-accent) 55%, var(--rp-surface-3));
  }
  .cell.queued {
    fill: color-mix(in oklab, var(--rp-amber) 45%, var(--rp-surface-3));
  }
  .cell.rejected {
    fill: color-mix(in oklab, var(--rp-red) 35%, var(--rp-surface-3));
  }
  .limit {
    fill: none;
    stroke: var(--rp-accent);
    stroke-width: 2;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: rp-draw 2.2s ease-out 0.3s forwards;
  }
  .run.lose {
    fill: var(--rp-surface-3);
    stroke: var(--rp-hairline-strong);
  }
  .run.win {
    fill: color-mix(in oklab, var(--rp-accent) 70%, transparent);
  }
  .win-dot {
    fill: var(--rp-accent);
  }
  .check {
    fill: none;
    stroke: var(--rp-bg);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .deadline {
    stroke: var(--rp-accent);
    stroke-dasharray: 3 5;
    opacity: 0.6;
  }
  .src,
  .store,
  .inst {
    fill: var(--rp-surface-2);
    stroke: var(--rp-hairline-strong);
  }
  .store {
    stroke: color-mix(in oklab, var(--rp-accent) 50%, transparent);
  }
  .branch {
    fill: none;
    stroke-width: 1.5;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: rp-draw 1.4s ease-out forwards;
  }
  .branch.accent,
  .chip.accent {
    stroke: var(--rp-accent);
  }
  .branch.amber,
  .chip.amber {
    stroke: var(--rp-amber);
  }
  .branch.red,
  .chip.red {
    stroke: var(--rp-red);
  }
  .branch.lavender,
  .chip.lavender {
    stroke: var(--rp-accent-2);
  }
  .chip {
    fill: var(--rp-surface-2);
    stroke-opacity: 0.55;
  }
  .code.accent {
    fill: var(--rp-accent);
  }
  .code.amber {
    fill: var(--rp-amber);
  }
  .code.red {
    fill: var(--rp-red);
  }
  .code.lavender {
    fill: var(--rp-accent-2);
  }
  .link {
    stroke: color-mix(in oklab, var(--rp-accent) 45%, transparent);
    stroke-dasharray: 4 6;
    animation: rp-flow 1.6s linear infinite;
  }
  .led.closed {
    fill: var(--rp-green);
  }
  .led.open {
    fill: var(--rp-red);
  }
  .tickline {
    stroke: var(--rp-hairline-strong);
  }
  .mark {
    fill: var(--rp-surface-3);
    stroke: var(--rp-accent);
  }
  .ff {
    fill: color-mix(in oklab, var(--rp-accent) 25%, transparent);
    transform-origin: left;
    animation: rp-ff 2.4s ease-in-out infinite;
  }
  @keyframes rp-rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes rp-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes rp-flow {
    to {
      stroke-dashoffset: -20;
    }
  }
  @keyframes rp-ff {
    0% {
      transform: scaleX(0);
    }
    60%,
    100% {
      transform: scaleX(1);
    }
  }
</style>
