---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import SignalField from '../components/landing/SignalField.astro';
import Illustration from '../components/landing/Illustration.astro';

const heroCode = `import { ResiliencePipelineBuilder } from 'resilience-pipeline';

const payments = new ResiliencePipelineBuilder({ name: 'payments' })
  .addFallback({ fallbackAction: () => queueForLater() })
  .addRetry({ maxRetryAttempts: 3, backoffType: 'exponential', useJitter: 'full' })
  .addCircuitBreaker({ failureRatio: 0.5, minimumThroughput: 20 })
  .addTimeout('2s')
  .build();

const receipt = await payments.execute(({ signal }) => charge(order, { signal }));`;

const bento = [
  {
    kind: 'failures',
    tag: 'Failures',
    title: 'Retry what is worth retrying. Stop hammering what is down.',
    body: 'Exponential backoff with jitter and Retry-After, a circuit breaker that opens before the outage spreads, and fallbacks that answer anyway. 4xx errors are never retried.',
    href: '/strategies/retry/',
    wide: true,
    code: `.addRetry({ backoffType: 'exponential', useJitter: 'full' })
.addCircuitBreaker({ consecutiveFailures: 5, breakDuration: '30s' })
.addFallback({ fallbackValue: cached })`,
  },
  {
    kind: 'overload',
    tag: 'Overload',
    title: 'Limits that tune themselves.',
    body: 'Bulkheads with priority queues, token buckets and sliding windows per user, and an adaptive concurrency limit that finds the right number from latency.',
    href: '/strategies/adaptive-concurrency/',
    code: `.addAdaptiveConcurrencyLimiter({ algorithm: 'gradient2' })
.addPartitionedRateLimiter({ partitionKey: (ctx) => tenant(ctx), … })`,
  },
  {
    kind: 'latency',
    tag: 'Latency',
    title: 'Cut the slow tail.',
    body: 'Hedging races a second attempt against a slow one. Timeouts abort the work, not just the wait, and deadlines flow into every nested call.',
    href: '/strategies/hedging/',
    code: `.addHedging({ delay: '200ms', maxHedgedAttempts: 2 })
.addTimeout('2s') // nested pipelines inherit the deadline`,
  },
  {
    kind: 'typed',
    tag: 'Typed errors',
    title: 'The compiler knows every way it can fail.',
    body: 'settle() returns a typed outcome. Outcome.match makes you handle each error code, and forgetting one is a compile error.',
    href: '/concepts/typed-errors/',
    code: `Outcome.match(await pipeline.settle(load), {
  ok: (user) => user,
  TIMEOUT: () => cached,
  CIRCUIT_OPEN: () => cached,
  UNEXPECTED: (e) => { throw e },
})`,
  },
  {
    kind: 'distributed',
    tag: 'Distributed',
    title: 'One decision across every instance.',
    body: 'Share circuit state, rate limits, locks and caches through Redis. Atomic Lua scripts, fencing tokens, Cluster-safe keys.',
    href: '/integrations/redis/',
    code: `extensions: [sharedCircuitState({ store: new RedisCircuitStateStore({ client }), key: 'payments' })]`,
  },
  {
    kind: 'testing',
    wide: true,
    tag: 'Testing',
    title: 'Test a 30-second outage in milliseconds.',
    body: 'FakeTimeProvider drives every retry delay, timeout and open circuit. No sleeps, no flaky tests.',
    href: '/guides/testing/',
    code: `const time = new FakeTimeProvider();
const done = assert.rejects(pipeline.execute(neverResolves));
await time.runAll(); // 34 virtual seconds, instantly`,
  },
] as const;

const toolbox = [
  {
    title: 'Failure',
    items: [
      ['addRetry', 'Backoff, jitter, budgets'],
      ['addCircuitBreaker', 'Stop calling what is down'],
      ['addTimeout', 'Abort, not just wait'],
      ['addFallback', 'Answer anyway'],
      ['addHedging', 'Race the slow tail'],
    ],
  },
  {
    title: 'Load',
    items: [
      ['addConcurrencyLimiter', 'Bulkhead with priorities'],
      ['addAdaptiveConcurrencyLimiter', 'Self-tuning limit'],
      ['addRateLimiter', 'Token bucket'],
      ['addPartitionedRateLimiter', 'Per user, per tenant'],
      ['addCache · addCoalesce', 'Cache and single-flight'],
    ],
  },
  {
    title: 'Types & flow',
    items: [
      ['settle()', 'Typed outcome, never throws'],
      ['Outcome.match()', 'Exhaustive by error code'],
      ['executeStream()', 'Commit after the first chunk'],
      ['addLock', 'Leases with fencing tokens'],
      ['createBatcher', 'DataLoader-style batching'],
    ],
  },
  {
    title: 'Run & observe',
    items: [
      ['/fetch · /axios', 'HTTP clients, per host'],
      ['/http · /fastify · /koa', 'Inbound deadlines, shedding'],
      ['/otel · /prometheus', 'Spans and metrics'],
      ['FakeTimeProvider', 'Test without waiting'],
      ['setGlobalChaos', 'Game days on demand'],
    ],
  },
];

const inCode = {
  http: `import { createResilientFetch } from 'resilience-pipeline/fetch';

// Per-host breakers, retries that honour Retry-After, idempotency-aware POSTs.
const http = createResilientFetch({ name: 'github', retryOn: [429, 503] });

const res = await http('https://api.github.com/repos/nodejs/node', {
  resilience: { timeout: '3s' },
});`,
  db: `// A timeout that really stops the query on the server.
const db = new ResiliencePipelineBuilder()
  .addRetry({ shouldHandle: ({ outcome }) => isSerializationFailure(outcome) })
  .addTimeout('1s')
  .build();

await db.execute(({ signal }) => transaction(signal, async (tx) => {
  // pg_cancel_backend runs when \`signal\` aborts
}));`,
  stream: `// Retried until the first token arrives, committed after it.
for await (const token of pipeline.executeStream(({ signal }) =>
  openai.stream(prompt, { signal }))) {
  render(token);
}`,
  testing: `import { FakeTimeProvider } from 'resilience-pipeline/testing';

const time = new FakeTimeProvider();
const pipeline = new ResiliencePipelineBuilder({ timeProvider: time })
  .addRetry({ delay: '10s', maxRetryAttempts: 3 })
  .addTimeout('1s')
  .build();

const done = assert.rejects(pipeline.execute(() => new Promise(() => {})));
await time.runAll(); // 34 virtual seconds
await done;`,
};
---

<StarlightPage frontmatter={{ title: 'resilience-pipeline', description: 'Resilience pipelines for TypeScript: retry, circuit breaker, timeout, hedging, rate limiting and typed errors for every runtime.', template: 'splash', pagefind: false }}>
  <div class="rp-landing not-content">
    <section class="hero">
      <SignalField />
      <div class="hero-inner">
        <a class="badge" href="/start/why/"><span class="dot"></span>Zero dependencies · Node, Bun, Deno, Workers, browsers</a>
        <h1>Failures are inevitable.<br /><span>Outages are optional.</span></h1>
        <p class="lede">
          Retry, circuit breaker, timeout, hedging, rate limiting and typed errors, composed into one pipeline. A Polly v8 API for TypeScript, from 4 KB.
        </p>
        <div class="actions">
          <a class="btn primary" href="/start/quick-start/">Get started</a>
          <a class="btn ghost" href="/playground/">Open the playground</a>
        </div>
        <button class="install" type="button" data-copy="npm i resilience-pipeline">
          <span class="prompt">$</span> npm i resilience-pipeline <span class="copy">copy</span>
        </button>
      </div>
      <div class="hero-code">
        <Code code={heroCode} lang="ts" title="payments.ts" />
      </div>
    </section>

    <section class="stats" aria-label="At a glance">
      <div><strong>0</strong><span>dependencies</span></div>
      <div><strong>4 KB</strong><span>retry, min+gzip</span></div>
      <div><strong>14</strong><span>strategies</span></div>
      <div><strong>230+</strong><span>tests</span></div>
      <div><strong>ESM + CJS</strong><span>typed, tree-shakeable</span></div>
    </section>

    <section class="section">
      <p class="rp-eyebrow">What it does</p>
      <h2>Every failure mode, one pipeline.</h2>
      <div class="bento">
        {bento.map((b) => (
          <article class:list={['card', { wide: 'wide' in b && b.wide }]}>
            <div class="art"><Illustration kind={b.kind} /></div>
            <div class="card-body">
              <span class="tag">{b.tag}</span>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
              <a class="more" href={b.href}>Read more <span aria-hidden="true">→</span></a>
            </div>
            <div class="card-code"><Code code={b.code} lang="ts" /></div>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <p class="rp-eyebrow">The toolbox</p>
      <h2>Everything a call to a flaky dependency needs.</h2>
      <div class="toolbox">
        {toolbox.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map(([api, desc]) => (
                <li><code>{api}</code><span>{desc}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <p class="rp-eyebrow">In code</p>
      <h2>Real problems, a few lines each.</h2>
      <div class="incode">
        <Tabs>
          <TabItem label="HTTP"><Code code={inCode.http} lang="ts" /></TabItem>
          <TabItem label="Databases"><Code code={inCode.db} lang="ts" /></TabItem>
          <TabItem label="Streaming"><Code code={inCode.stream} lang="ts" /></TabItem>
          <TabItem label="Testing"><Code code={inCode.testing} lang="ts" /></TabItem>
        </Tabs>
      </div>
    </section>

    <section class="cta">
      <SignalField intensity="quiet" />
      <div class="cta-inner">
        <p class="rp-eyebrow">Get started</p>
        <h2>Wrap one call. Grow from there.</h2>
        <p class="lede">Start with a retry and a timeout. Add a breaker when the first incident teaches you why.</p>
        <div class="actions">
          <a class="btn primary" href="/start/quick-start/">Read the quick start</a>
          <a class="btn ghost" href="/playground/">Break things in the playground</a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <span>resilience-pipeline · MIT licensed</span>
      <nav aria-label="Footer">
        <a href="/start/introduction/">Docs</a>
        <a href="/reference/changelog/">Changelog</a>
        <a href="https://www.npmjs.com/package/resilience-pipeline">npm</a>
      </nav>
    </footer>
  </div>
</StarlightPage>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      const label = button.querySelector('.copy');
      if (!label) return;
      label.textContent = 'copied';
      setTimeout(() => (label.textContent = 'copy'), 1400);
    });
  }
</script>

<style>
  /* The splash template still renders the page title and constrains width: hide one, break out of the other. */
  :global(main:has(.rp-landing) .content-panel:first-of-type) {
    display: none;
  }
  :global(main:has(.rp-landing) .content-panel) {
    padding: 0;
  }
  :global(main:has(.rp-landing) .sl-container) {
    max-width: none;
  }
  .rp-landing {
    --max: 72rem;
    color: var(--rp-text);
  }
  .section,
  .stats,
  .foot {
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6.5rem 1.5rem 0;
    border-bottom: 1px solid var(--rp-hairline);
    background: radial-gradient(ellipse 80% 60% at 50% 0%, color-mix(in oklab, var(--rp-accent) 7%, transparent), transparent);
  }
  .hero-inner {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.8rem 0.3rem 0.55rem;
    border: 1px solid var(--rp-hairline-strong);
    border-radius: 999px;
    background: color-mix(in oklab, var(--rp-surface) 80%, transparent);
    backdrop-filter: blur(8px);
    font-family: var(--rp-mono);
    font-size: 0.72rem;
    color: var(--rp-text-muted);
    text-decoration: none;
  }
  .badge .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--rp-accent);
    box-shadow: 0 0 10px var(--rp-accent);
  }
  .hero h1 {
    margin: 1.6rem 0 0;
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.6rem);
    line-height: 1.02;
    font-weight: 650;
    letter-spacing: -0.045em;
    color: var(--sl-color-white);
  }
  .hero h1 span {
    color: color-mix(in oklab, var(--sl-color-white) 55%, var(--rp-text-faint));
  }
  .lede {
    margin: 1.4rem auto 0;
    max-width: 36rem;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--rp-text-muted);
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 1.15rem;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 550;
    text-decoration: none;
    transition: transform 0.15s, background 0.15s, border-color 0.15s;
  }
  .btn.primary {
    background: var(--sl-color-white);
    color: var(--rp-bg);
  }
  .btn.primary:hover {
    transform: translateY(-1px);
  }
  .btn.ghost {
    border: 1px solid var(--rp-hairline-strong);
    color: var(--sl-color-white);
    background: color-mix(in oklab, var(--rp-surface) 70%, transparent);
  }
  .btn.ghost:hover {
    border-color: color-mix(in oklab, var(--rp-accent) 50%, transparent);
  }
  .install {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    border: 1px solid var(--rp-hairline);
    border-radius: 10px;
    background: color-mix(in oklab, var(--rp-surface) 85%, transparent);
    font-family: var(--rp-mono);
    font-size: 0.82rem;
    color: var(--rp-text);
    cursor: pointer;
  }
  .install .prompt {
    color: var(--rp-accent);
  }
  .install .copy {
    font-size: 0.68rem;
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
    background: var(--rp-surface-2);
    color: var(--rp-text-faint);
  }
  .hero-code {
    position: relative;
    max-width: 50rem;
    margin: 3.5rem auto -1px;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -30px 80px -20px color-mix(in oklab, var(--rp-accent) 18%, transparent);
  }
  .hero-code :global(.expressive-code .frame) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  /* Stats strip */
  .stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-inline: 1px solid var(--rp-hairline);
    padding: 0;
  }
  .stats div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.6rem 1.4rem;
    border-inline-end: 1px solid var(--rp-hairline);
  }
  .stats div:last-child {
    border-inline-end: none;
  }
  .stats strong {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .stats span {
    font-family: var(--rp-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--rp-text-faint);
    text-transform: uppercase;
  }

  /* Sections */
  .section {
    padding-top: 6.5rem;
  }
  .section h2,
  .cta h2 {
    margin: 0.7rem 0 2.2rem;
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    font-weight: 620;
    color: var(--sl-color-white);
    max-width: 34rem;
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rp-hairline);
    border-radius: 18px;
    background: linear-gradient(180deg, var(--rp-surface), color-mix(in oklab, var(--rp-surface) 60%, var(--rp-bg)));
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--rp-hairline-strong);
  }
  .card.wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    grid-template-rows: auto 1fr;
  }
  .card.wide .art {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    border-bottom: 0;
    border-left: 1px solid var(--rp-hairline);
    padding: 2rem;
  }
  .card.wide .card-body {
    grid-column: 1;
    grid-row: 1;
    padding-top: 2rem;
  }
  .card.wide .card-code {
    grid-column: 1;
    grid-row: 2;
  }
  .art {
    padding: 1.4rem 1.4rem 0.4rem;
    border-bottom: 1px solid var(--rp-hairline);
    background: radial-gradient(ellipse 70% 90% at 50% 100%, color-mix(in oklab, var(--rp-accent) 5%, transparent), transparent);
  }
  .card-body {
    padding: 1.4rem 1.5rem 0.4rem;
  }
  .tag {
    font-family: var(--rp-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rp-text-faint);
    border: 1px solid var(--rp-hairline);
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
  }
  .card h3 {
    margin: 0.9rem 0 0.5rem;
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--rp-text-muted);
  }
  .more {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .more:hover span {
    color: var(--rp-accent);
  }
  .card-code {
    margin: 1rem 1.25rem 1.25rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .card-code :global(pre) {
    font-size: 0.78rem !important;
  }

  /* Toolbox */
  .toolbox {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--rp-hairline);
  }
  .toolbox > div {
    padding: 1.5rem 1.25rem 0 0;
  }
  .toolbox h3 {
    margin: 0 0 1rem;
    font-family: var(--rp-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rp-text-faint);
  }
  .toolbox ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.95rem;
  }
  .toolbox code {
    display: block;
    font-family: var(--rp-mono);
    font-size: 0.82rem;
    color: var(--sl-color-white);
    background: none;
    border: none;
    padding: 0;
  }
  .toolbox span {
    font-size: 0.82rem;
    color: var(--rp-text-faint);
  }

  /* In code */
  .incode {
    border: 1px solid var(--rp-hairline);
    border-radius: 16px;
    padding: 0.5rem 1.25rem 1.25rem;
    background: var(--rp-surface);
  }

  /* CTA */
  .cta {
    position: relative;
    overflow: hidden;
    margin-top: 7rem;
    padding: 7rem 1.5rem;
    border-block: 1px solid var(--rp-hairline);
    text-align: center;
  }
  .cta-inner {
    position: relative;
  }
  .cta h2 {
    margin-inline: auto;
  }

  /* Footer */
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2.5rem;
    font-size: 0.82rem;
    color: var(--rp-text-faint);
  }
  .foot nav {
    display: flex;
    gap: 1.25rem;
  }
  .foot a {
    color: var(--rp-text-faint);
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--sl-color-white);
  }

  @media (max-width: 60rem) {
    .bento {
      grid-template-columns: 1fr;
    }
    .card.wide {
      display: flex;
    }
    .card.wide .art {
      border-left: 0;
      border-bottom: 1px solid var(--rp-hairline);
    }
    .toolbox {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats div {
      border-bottom: 1px solid var(--rp-hairline);
    }
  }
  @media (max-width: 34rem) {
    .hero {
      padding-top: 4rem;
    }
    .toolbox {
      grid-template-columns: 1fr;
    }
    .foot {
      flex-direction: column;
    }
  }
</style>
