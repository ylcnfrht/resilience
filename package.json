    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  },
  "unpkg": "./dist/browser/resilience.min.js",
  "jsdelivr": "./dist/browser/resilience.min.js",
  "publishConfig": {
    "access": "public"
  }
}
