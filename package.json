      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/esm/adapters.d.ts",
        "default": "./dist/esm/adapters.js"
      },
      "require": {
        "types": "./dist/cjs/adapters.d.ts",
        "default": "./dist/cjs/adapters.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/esm/nestjs.d.ts",
        "default": "./dist/esm/nestjs.js"
      },
      "require": {
        "types": "./dist/cjs/nestjs.d.ts",
        "default": "./dist/cjs/nestjs.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node scripts/browser.mjs",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "check:package": "npm run build && npx -y publint && npx -y @arethetypeswrong/cli --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node scripts/size.mjs",
    "check:size": "npm run build && node scripts/size.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "@opentelemetry/api": "^1.4.0",
    "axios": ">=1.0.0",
    "fastify": ">=4",
    "koa": ">=2",
    "prom-client": ">=14"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "axios": "^1.21.0",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "hono": "^4.13.18",
    "ioredis": "^5.11.1",
    "koa": "^3.3.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
