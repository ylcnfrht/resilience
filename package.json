{
  "name": "@ylcnfrht/resilience",
  "version": "0.3.0",
  "description": "Resilience pipelines for TypeScript: retry, circuit breaker, timeout, hedging, rate limiting and typed errors. A Polly v8 API for Node, Bun, Deno, Workers and browsers. Zero dependencies.",
  "keywords": [
    "resilience",
    "retry",
    "backoff",
    "circuit-breaker",
    "timeout",
    "hedging",
    "fallback",
    "bulkhead",
    "rate-limiter",
    "rate-limiting",
    "fault-tolerance",
    "polly",
    "chaos",
    "abortsignal",
    "typescript",
    "fetch",
    "axios",
    "express",
    "fastify",
    "hono",
    "koa",
    "nestjs",
    "redis",
    "opentelemetry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylcnfrht/resilience.git"
  },
  "homepage": "https://resilience.ferhatyalcin.dev",
  "bugs": {
    "url": "https://github.com/ylcnfrht/resilience/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/ylcnfrht"
  },
  "author": {
    "name": "ylcnfrht",
    "url": "https://github.com/ylcnfrht"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "nestjs": [
        "./dist/cjs/nestjs.d.ts"
      ],
      "testing": [
        "./dist/cjs/testing.d.ts"
      ],
      "fetch": [
        "./dist/cjs/fetch.d.ts"
      ],
      "otel": [
        "./dist/cjs/otel.d.ts"
      ],
      "prometheus": [
        "./dist/cjs/prometheus.d.ts"
      ],
      "http": [
        "./dist/cjs/http.d.ts"
      ],
      "redis": [
        "./dist/cjs/redis.d.ts"
      ],
      "adapters": [
        "./dist/cjs/adapters.d.ts"
      ],
      "axios": [
        "./dist/cjs/axios.d.ts"
      ],
      "fastify": [
        "./dist/cjs/fastify.d.ts"
      ],
      "koa": [
        "./dist/cjs/koa.d.ts"
      ],
      "hystrix": [
        "./dist/cjs/hystrix.d.ts"
      ],
      "outcome": [
        "./dist/cjs/outcome.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./outcome": {
      "import": {
        "types": "./dist/esm/outcome.d.ts",
        "default": "./dist/esm/outcome.js"
      },
      "require": {
        "types": "./dist/cjs/outcome.d.ts",
        "default": "./dist/cjs/outcome.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/esm/fetch.d.ts",
        "default": "./dist/esm/fetch.js"
      },
      "require": {
        "types": "./dist/cjs/fetch.d.ts",
        "default": "./dist/cjs/fetch.js"
      }
    },
    "./axios": {
      "import": {
        "types": "./dist/esm/axios.d.ts",
